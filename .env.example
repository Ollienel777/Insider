# Every variable the app reads (SPEC §7). Names only: copy to .env.local and
# fill in what you have. Nothing is required; with no .env.local the app runs
# fully on fixtures. The gate forces every *_MODE to fake whatever this says.

# `live` turns on live mode where keys exist; anything else is fake.
HEIST_MODE=
# Per-service overrides, `fake` or `live`; each defaults to HEIST_MODE.
LLM_MODE=
COSTAR_MODE=
VEXCEL_MODE=
NEXT_PUBLIC_MATTERPORT_MODE=

# Model: `anthropic` (default) or `bedrock`.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_BUILDER=
# `1` allows Bedrock calls.
BEDROCK_ENABLED=
AWS_REGION=
BEDROCK_MODEL_ID=
# Crew and Chief timeout before the fake answers, in ms (default 4000).
LLM_TIMEOUT_MS=

# The unpacked CoStar data kit, outside the repo (never commit its files).
COSTAR_KIT_DIR=
# The kit buildings the demo shows, as building:mission pairs, for example
# 52227:romaine-1974,254167:sunset-1986. Only these kit buildings show, and
# their levels are built in memory when the server starts. Empty: every kit
# building shows, and builds on demand.
SHOWCASE_LEVELS=
VEXCEL_API_BASE=
VEXCEL_API_KEY=
# Showcase SDK key (domain-bound, used in the browser).
NEXT_PUBLIC_MATTERPORT_SDK_KEY=
# Dev only (ignored in a production build): a model id for every building, or
# `buildingId=modelId` pairs separated by commas, for a local live test. Never
# commit a model id from the kit.
NEXT_PUBLIC_MATTERPORT_MODEL_OVERRIDE=

# Server port, also the smoke test's (default 3100).
PORT=
# Where the server looks for the demo epoch (default `.heist/` in the app's
# directory, where `npm run demo:reset` writes it). Only the tests set it.
HEIST_STATE_DIR=
# `1` adds the fictional test kit's one building (900101) to fake CoStar, by id
# only, for the recorded kit path in the smoke. Only playwright.config.ts sets it.
HEIST_TEST_KIT=
